{
  "name": "web-monitor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Repository-level tooling. The backend, dashboard and SDK each install their own dependencies; this exists so linting and formatting are configured once rather than three times.",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.19.0"
  }
}
