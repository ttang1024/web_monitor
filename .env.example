# Used by the root docker-compose.yml (the full stack).
# The API's own variables live in backend/.env.example.

# Required — at least 32 characters. Compose refuses to start without it.
JWT_SECRET=change-me-to-something-at-least-32-characters-long
JWT_ISSUER=MonitoringSaaS
JWT_AUDIENCE=MonitoringSaasUsers

# Required — no defaults. The API connects as MYSQL_USER, not root.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=monitoring_saas
MYSQL_USER=monitoring
MYSQL_PASSWORD=

# Origins allowed to call the dashboard API (/graphql). The dashboard container
# is published on :8080. SDK ingestion (/ingest) accepts any origin; restrict a
# key to your sites with its origin allowlist on the Projects page.
ALLOWED_ORIGINS=http://localhost:8080

# Reverse proxies in front of the API (e.g. 1 behind a load balancer). Leave
# false when the API is exposed directly, or client IPs become forgeable.
TRUST_PROXY=false

# Baked into the dashboard bundle at build time — changing it needs a rebuild.
DASHBOARD_API_URL=http://localhost:4000/graphql

# Optional: enables the dashboard's AI analysis panel.
GEMINI_API_KEY=

# How long ingested events are kept before the retention sweep removes them.
RETENTION_DAYS=90
ALERTS_ENABLED=true
