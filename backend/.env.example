DATABASE_URL="mysql://root:yourpassword@localhost:3306/monitoring_saas"

PORT=4000

# Must be at least 32 characters; the API refuses to start otherwise.
JWT_SECRET="your-super-secret-key-change-this-in-production-min-32-chars"
JWT_ISSUER="MonitoringSaaS"
JWT_AUDIENCE="MonitoringSaasUsers"

# Access tokens are short-lived and held in memory by the dashboard; the
# refresh token is an httpOnly cookie that renews them.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# lax when dashboard and API share a site (localhost:3000 + localhost:4000 do);
# none (HTTPS only) when they are on different sites.
REFRESH_COOKIE_SAMESITE=lax

# Origins allowed to call the dashboard API (/graphql). Required in production.
# SDK ingestion (/ingest) accepts any origin; keys carry their own allowlist.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Reverse proxies in front of the API: a hop count (e.g. 1) or a list of
# proxy addresses. false = trust none, so X-Forwarded-For can't be forged.
TRUST_PROXY=false

# Optional: share rate limits across API instances. Without it each instance
# limits on its own.
# REDIS_URL=redis://localhost:6379

# Ingest batches written at once per instance before answering 503.
INGEST_MAX_CONCURRENCY=8

# Allow alert webhooks to private/loopback addresses (local testing only).
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

NODE_ENV=development

# Optional: powers the dashboard's "AI Insights" panel via Gemini. Held here,
# server-side, only — never put this in the dashboard's env, it would ship to
# every visitor's browser.
GEMINI_API_KEY=
