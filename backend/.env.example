DATABASE_URL="mysql://root:yourpassword@localhost:3306/monitoring_saas"

PORT=4000

# Must be at least 32 characters; the API refuses to start otherwise.
JWT_SECRET="your-super-secret-key-change-this-in-production-min-32-chars"
JWT_ISSUER="MonitoringSaaS"
JWT_AUDIENCE="MonitoringSaasUsers"

# Access token lifetime (any ms-style duration), and how long a refresh token
# stays valid before the user has to sign in again.
ACCESS_TOKEN_TTL=24h
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

NODE_ENV=development
