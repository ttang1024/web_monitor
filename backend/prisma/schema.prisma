generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum SubscriptionPlan {
  Free
  Pro
  Enterprise
}

enum UserRole {
  User
  Admin
}

enum ErrorStatus {
  Unresolved
  Resolved
  Ignored
  // A resolved error that started happening again.
  Regressed
}

enum AlertCondition {
  // An error hash reported for the first time inside the window.
  NewIssue
  // Total error occurrences in the window exceeded the threshold.
  ErrorSpike
  // Errors as a percentage of all events in the window exceeded the threshold.
  ErrorRate
  // Average page load time over the window exceeded the threshold, in ms.
  SlowPageLoad
}

enum AlertSeverity {
  Info
  Warning
  Critical
}

model Tenant {
  id                 String           @id @default(uuid()) @db.Char(36)
  name               String
  domain             String
  plan               SubscriptionPlan @default(Free)
  isActive           Boolean          @default(true)
  maxUsers           Int              @default(5)
  maxApiKeys         Int              @default(3)
  monthlyEventLimit  BigInt           @default(100000)
  currentMonthEvents BigInt           @default(0)
  monthlyResetDate   DateTime
  createdAt          DateTime         @default(now())
  updatedAt          DateTime?        @updatedAt

  users             User[]
  apiKeys           ApiKey[]
  errorLogs         ErrorLog[]
  errorBuckets      ErrorBucket[]
  performanceMetrics PerformanceMetric[]
  apiErrors         ApiError[]
  customEvents      CustomEvent[]
  dashboardLayouts  DashboardLayout[]
  alertRules        AlertRule[]
  alertNotifications AlertNotification[]
}

model User {
  id           String    @id @default(uuid()) @db.Char(36)
  tenantId     String    @db.Char(36)
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole  @default(User)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dashboardLayouts DashboardLayout[]
  refreshTokens    RefreshToken[]

  // Login looks users up by email alone, so the address has to be unique
  // globally — not just per tenant. Enforced in the database because the
  // application-level "is this taken?" check races with itself.
  @@unique([email])
  @@index([tenantId])
}

// Refresh tokens are stored hashed: a leaked table row cannot be replayed as a token.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiKey {
  id             String    @id @default(uuid()) @db.Char(36)
  tenantId       String    @db.Char(36)
  name           String
  key            String    @unique
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  environment    String    @default("production")
  // JSON array of origins ("https://app.example.com") allowed to ingest with
  // this key. An ingest key ships in public page source, so this is the only
  // thing stopping someone else's site from spending the quota. Empty or null
  // means "any origin", which is what a brand new key starts as.
  allowedOrigins Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ErrorLog {
  id              String    @id @default(uuid()) @db.Char(36)
  tenantId        String    @db.Char(36)
  type            String
  message         String    @db.Text
  stackTrace      String?   @db.Text
  source          String?
  lineNumber      Int?
  columnNumber    Int?
  url             String    @db.Text
  userAgent       String    @db.Text
  timestamp       BigInt
  errorHash       String
  occurrenceCount Int         @default(1)
  status          ErrorStatus @default(Unresolved)
  lastSeenAt      DateTime    @default(now())
  metadata        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime?   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, errorHash])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, lastSeenAt])
}

// Errors collapse into one ErrorLog row per hash, which loses their shape over time.
// This keeps an hourly counter per hash so each issue still has a real trend line.
model ErrorBucket {
  id          String   @id @default(uuid()) @db.Char(36)
  tenantId    String   @db.Char(36)
  errorHash   String
  bucketStart DateTime
  count       Int      @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, errorHash, bucketStart])
  @@index([tenantId, bucketStart])
}

model PerformanceMetric {
  id            String    @id @default(uuid()) @db.Char(36)
  tenantId      String    @db.Char(36)
  url           String    @db.Text
  userAgent     String    @db.Text
  timestamp     BigInt
  lcp           Float?
  fcp           Float?
  cls           Float?
  fid           Float?
  ttfb          Float?
  dnsTime       Float?
  tcpTime       Float?
  responseTime  Float?
  domLoadTime   Float?
  loadTime      Float?
  deviceType    String?
  browser       String?
  os            String?
  country       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model ApiError {
  id              String    @id @default(uuid()) @db.Char(36)
  tenantId        String    @db.Char(36)
  type            String
  requestUrl      String    @db.Text
  method          String    @default("GET")
  statusCode      Int?
  errorMessage    String?   @db.Text
  pageUrl         String    @db.Text
  userAgent       String    @db.Text
  timestamp       BigInt
  requestHeaders  Json?
  responseHeaders Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime? @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model CustomEvent {
  id        String    @id @default(uuid()) @db.Char(36)
  tenantId  String    @db.Char(36)
  eventName String
  url       String    @db.Text
  userAgent String    @db.Text
  timestamp BigInt
  data      Json?
  userId    String?
  sessionId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, eventName, createdAt])
}

// A condition the tenant wants to hear about. Evaluated on a fixed interval
// against the window ending now, not on the ingest path — a burst of 500 errors
// should cost one evaluation, not 500.
model AlertRule {
  id       String         @id @default(uuid()) @db.Char(36)
  tenantId String         @db.Char(36)
  name     String
  condition AlertCondition
  // Interpreted per condition: occurrences (ErrorSpike), percent (ErrorRate),
  // milliseconds (SlowPageLoad). Ignored by NewIssue.
  threshold Float         @default(0)
  windowMinutes Int       @default(60)
  severity AlertSeverity  @default(Warning)
  isEnabled Boolean       @default(true)
  // A condition that stays true would otherwise fire on every sweep. After a
  // rule triggers it stays quiet for this long.
  cooldownMinutes Int     @default(60)
  lastTriggeredAt DateTime?
  // Optional outbound POST when the rule fires. Notifications are recorded
  // either way, so delivery failing never loses the alert.
  webhookUrl String?      @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime?     @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notifications AlertNotification[]

  @@index([tenantId, isEnabled])
}

// One firing of a rule. Kept even when webhook delivery fails so the dashboard
// is always the complete record.
model AlertNotification {
  id          String        @id @default(uuid()) @db.Char(36)
  tenantId    String        @db.Char(36)
  alertRuleId String        @db.Char(36)
  title       String
  body        String        @db.Text
  severity    AlertSeverity
  // What the rule measured, against what it was compared to.
  observedValue Float
  threshold   Float
  // Set for NewIssue, so the dashboard can link straight to the issue.
  errorHash   String?
  isRead      Boolean       @default(false)
  deliveredAt DateTime?
  deliveryError String?     @db.Text
  createdAt   DateTime      @default(now())

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule   AlertRule @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, isRead])
  @@index([alertRuleId])
}

model DashboardLayout {
  id            String    @id @default(uuid()) @db.Char(36)
  tenantId      String    @db.Char(36)
  userId        String    @db.Char(36)
  name          String    @default("Default Dashboard")
  isDefault     Boolean   @default(false)
  configuration Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}
